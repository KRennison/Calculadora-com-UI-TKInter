import tkinter as tk

def dividir():
    try:
        n1 = float(campo1.get())
        n2 = float(campo2.get())
        resultado.config(text=str(n1 / n2))
    except:
        resultado.config(text="Erro! Digite números válidos.")

janela = tk.Tk()
janela.title("Calculadora")

tk.Label(janela, text="Dividendo").pack()
campo1 = tk.Entry(janela)
campo1.pack()

tk.Label(janela, text="Divisor").pack()
campo2 = tk.Entry(janela)
campo2.pack()

tk.Button(janela, text="Dividir", command=dividir).pack()

resultado = tk.Label(janela, text="Resultado")
resultado.pack()

janela.mainloop()
